      "description": "Shared danger action with visible focus and reduced-motion support.",
      "html": "<button class=\"ds-btn ds-btn-danger\">Delete record</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:44px;padding:13px 20px;border-radius:8px;border:0;font-family:\"Manrope Variable\",sans-serif;font-size:12px;font-weight:800;letter-spacing:.015em;cursor:pointer;transition:background .2s,transform .2s}.ds-btn:hover{transform:translateY(-1px)}.ds-btn:focus-visible{outline:2px solid var(--accent,#ff4d57);outline-offset:4px}.ds-btn:active{transform:translateY(0)}.ds-btn:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition-duration:.01ms}}.ds-btn-danger{background:#a8283b;color:#fff0f1}"
    },
    {
      "name": "Number Field",
      "kind": "input",
      "refersTo": "field",
      "description": "A labelled load input with tabular figures.",
      "html": "<label class=\"ds-field\">Load (kg)<input type=\"number\" value=\"20\" min=\"0\" step=\"0.5\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:#e1e2e9;font-family:\"Manrope Variable\",sans-serif;font-size:12px;font-weight:500}.ds-field input{min-width:0;min-height:44px;background:#15161b;border:1px solid #404452;border-radius:8px;color:#f6f7fb;padding:11px 13px;font:13px \"Manrope Variable\",sans-serif;font-variant-numeric:tabular-nums;caret-color:var(--accent,#ff4d57)}.ds-field input:focus{outline:2px solid var(--accent,#ff4d57);outline-offset:1px}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "The current workspace route has a crimson fill and trailing chevron.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#programs\" aria-current=\"page\">Training programs<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></a></nav>",
      "css": ".ds-nav{padding:12px;background:#11141d}.ds-nav a{display:flex;align-items:center;gap:13px;min-height:45px;padding:13px 12px;border-radius:8px;text-decoration:none;background:var(--accent,#ff4d57);color:#18090d;font:700 12px \"Manrope Variable\",sans-serif}.ds-nav svg{margin-left:auto}.ds-nav a:hover{background:#272931;color:#dfe1e9}.ds-nav a:focus-visible{outline:2px solid var(--accent,#ff4d57);outline-offset:4px}"
    },
    {
      "name": "Metadata Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Informational metadata rather than an implicit button.",
      "html": "<span class=\"ds-tag\">SOURCE PROGRAM</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;background:#3e202b;color:#ffbac1;border-radius:5px;padding:6px 9px;font:10px/1.3 \"Manrope Variable\",sans-serif;letter-spacing:.06em}"
    },
    {
      "name": "Shared Panel",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat tonal container with an honest empty state.",
      "html": "<section class=\"ds-card\"><h2>Your training history</h2><p>No completed sessions yet. Your next workout starts your history.</p></section>",
      "css": ".ds-card{background:var(--surface,#161922);color:#f6f7fb;border-radius:var(--radius,16px);padding:28px}.ds-card h2{margin:0 0 12px;font:700 1.9rem/1.3 \"Barlow Condensed\",sans-serif;letter-spacing:.005em;text-transform:uppercase}.ds-card p{margin:0;color:var(--muted,#b8becf);font:14px/1.8 \"Manrope Variable\",sans-serif;max-width:72ch}"
    },
    {
      "name": "Program Choice",
      "kind": "button",
      "refersTo": "program-choice",
      "description": "A source-program selector with an explicit pressed state.",
      "html": "<button class=\"ds-program\" aria-pressed=\"true\"><strong>Bulk with Buendia</strong><span>5-day rotating split · 5 templates</span></button>",
      "css": ".ds-program{position:relative;text-align:left;min-height:170px;padding:24px;background:#191c26;color:#f6f7fb;border:1px solid #363b4d;border-radius:14px;display:flex;flex-direction:column;align-items:flex-start;gap:15px;cursor:pointer;transition:background .2s,border-color .2s}.ds-program strong{font:700 28px/1 \"Barlow Condensed\",sans-serif;text-transform:uppercase;max-width:14ch}.ds-program span{font:10px \"Manrope Variable\",sans-serif;color:#bdc4d8}.ds-program[aria-pressed=\"true\"]{background:#3a1825;border-color:var(--accent,#ff4d57)}.ds-program:hover{background:#292330}.ds-program:focus-visible{outline:2px solid var(--accent,#ff4d57);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-program{transition-duration:.01ms}}"
    },
    {
      "name": "Expandable Source Set",
      "kind": "custom",
      "refersTo": "source-set",
      "description": "Source prescription and actual load stay distinct in an expandable set.",
      "html": "<details class=\"ds-set\"><summary><strong>Set 1</strong><span>15 reps · warm-up</span></summary><label>Actual load (kg)<input type=\"number\" min=\"0\" step=\"0.5\" placeholder=\"kg\"></label></details>",
      "css": ".ds-set{background:#1e2230;color:#f6f7fb;margin:15px 0;padding:19px 16px;border-radius:10px;font-family:\"Manrope Variable\",sans-serif}.ds-set summary{cursor:pointer;font-size:12px;line-height:1.8}.ds-set summary strong{color:var(--gold,#ffcf5c);font-size:14px;margin-right:15px}.ds-set summary:focus-visible,.ds-set input:focus-visible{outline:2px solid var(--accent,#ff4d57);outline-offset:4px}.ds-set label{display:flex;flex-direction:column;gap:8px;color:#c4cce0;font-size:10px;margin-top:20px}.ds-set input{min-height:40px;max-width:130px;border:1px solid #404452;background:#15161b;color:#f6f7fb;border-radius:8px;padding:9px;font:12px \"Manrope Variable\",sans-serif;font-variant-numeric:tabular-nums}"
    }
  ],
  "narrative": {
    "northStar": "The Championship Training Floor",
    "overview": "LÉMAQQUE brings the energy of a bodybuilding competition stage into a practical daily training companion. Matte black, competition crimson, spotlight gold, cool steel, and off-white establish a vibrant, assertive athletic identity. Condensed uppercase headlines deliver the competition character; readable forms and source-linked records keep that energy useful.\n\nThe user-requested Mr Olympia-inspired direction replaces the earlier sage, lime, champagne, and Space Grotesk system. LÉMAQQUE and the LMQ monogram remain the identity. This is an original visual interpretation: no official Olympia or athlete logos, photography, or endorsement claims.\n\nExpression scales with the task. Public storytelling uses large type and an original metallic abstract sculpture. Daily tracking uses a stable rail, clear controls, flat layered surfaces, and honest data states. Full tracking remains usable without WebGL.",
    "keyCharacteristics": [
      "Matte black with vivid crimson actions and gold emphasis.",
      "Heavy condensed display type paired with readable Manrope.",
      "Flat cool surfaces, thin steel separators, and rounded controls.",
      "Crimson, gold, and cobalt distinguish source-program families.",
      "Source-linked prescriptions, real records, and explicit empty states."
    ],
    "rules": [
      {
        "name": "The Action and Spotlight Rule",
        "body": "Use crimson for primary action, selection, progress, and keyboard focus. Use gold for editorial emphasis, source/rest cues, and selected section text. Keep both legible against their actual background.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Barlow Condensed for headings and prominent values, and Manrope for controls, records, and explanations. Keep essential prescriptions readable at their implemented body sizes.",
        "section": "typography"
      },
      {
        "name": "The Stable Workspace Rule",
        "body": "Keep desktop navigation fixed and mobile navigation in the shared drawer so daily task locations stay predictable.",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Keep ordinary cards shadow-free. Reserve the small crimson lift for the primary action and dimensional shading for artwork.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the matte-black, competition-crimson, spotlight-gold, cobalt, and off-white system with the retained LÉMAQQUE identity.",
      "Do use Barlow Condensed at the bundled heading weights and Manrope for functional reading.",
      "Do preserve visible crimson focus, readable source tables, and usable mobile logging controls.",
      "Do use real records, traceable prescriptions, explicit calculator inputs, and useful empty states.",
      "Do respect reduced motion and preserve full tracking without WebGL."
    ],
    "donts": [
      "Don't restore the retired sage/lime palette or Space Grotesk heading system.",
      "Don't use official Olympia or athlete logos, photos, or implied endorsements.",
      "Don't fill the interface with invented performance statistics, transformation claims, or nutrition values.",
      "Don't turn a decorative sculpture or unavailable/unvalidated motion asset into exercise instruction.",
      "Don't apply hero-scale typography or artwork to every tracking panel."
    ]
  }
}
